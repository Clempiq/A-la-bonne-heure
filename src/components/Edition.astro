---
import { RUBRIQUES, greeting, shortDate, siblings, slug, countLabel, typo } from "../lib/editions.js";
const { edition, isHome = false } = Astro.props;
const { newer, older } = siblings(edition.date);
const items = edition.items;
const words = [edition.intro, ...items.flatMap((i) => [i.title, i.summary, i.caveat ?? "", i.why])].join(" ").split(/\s+/).length;
const minutes = Math.max(1, Math.round(words / 200));
const ids = items.map((it, i) => `n${i + 1}-${slug(it.title)}`);
---
<article class="edition">
  <header class="ed-head">
    <p class="kicker">{isHome ? "Édition du jour" : "Édition du"} {!isHome && shortDate(edition.date)}</p>
    <h1 class="ed-title">{greeting(edition.date)}</h1>
    <p class="ed-meta">{countLabel(items.length)} · environ {minutes} minute{minutes > 1 ? "s" : ""} de lecture</p>
    <p class="ed-intro">{typo(edition.intro)}</p>
  </header>

  {items.length > 1 && (
    <nav class="toc" aria-label="Au sommaire">
      <h2 class="toc-title">Au sommaire</h2>
      <ol>
        {items.map((it, i) => (
          <li><a href={`#${ids[i]}`}>{typo(it.title)}</a></li>
        ))}
      </ol>
    </nav>
  )}

  {items.map((it, i) => (
    <section class="item" id={ids[i]} aria-labelledby={`${ids[i]}-t`}>
      <p class="kicker item-rub">{RUBRIQUES[it.rubrique]?.label ?? it.rubrique}</p>
      <h2 class="item-title" id={`${ids[i]}-t`}>{typo(it.title)}</h2>
      <p class="item-summary">{typo(it.summary)}</p>
      {it.caveat && <p class="item-caveat"><strong>À nuancer.</strong> {typo(it.caveat)}</p>}
      <p class="item-why"><strong>Pourquoi c'est important.</strong> {typo(it.why)}</p>
      <p class="item-sources">
        <span>{it.sources.length > 1 ? "Sources\u00A0:" : "Source\u00A0:"}</span>
        {it.sources.map((s, j) => (
          <>{j > 0 && <span class="sep" aria-hidden="true">·</span>}<a href={s.url} rel="noopener">{s.name}</a></>
        ))}
      </p>
    </section>
  ))}

  {items.length === 0 && <p class="empty">Aucune nouvelle n'a passé nos critères de sélection ce matin. Plutôt que d'enjoliver, nous préférons le dire.</p>}

  <nav class="ed-nav" aria-label="Autres éditions">
    {(older || !isHome) && <div class="ed-nav-row">
      {older
        ? <a class="btn" href={`/edition/${older.date}`} rel="prev"><span aria-hidden="true">←</span> Le {shortDate(older.date)}</a>
        : <span></span>}
      {!isHome && (newer
        ? <a class="btn" href={`/edition/${newer.date}`} rel="next">Le {shortDate(newer.date)} <span aria-hidden="true">→</span></a>
        : <a class="btn" href="/">Aujourd'hui <span aria-hidden="true">→</span></a>)}
    </div>}
    <a class="all" href="/archives">Toutes les éditions</a>
  </nav>
</article>

<style>
  .ed-head { margin-bottom: 8px; }
  .ed-title { font-size: clamp(34px, 8.4vw, 50px); margin: 10px 0 10px; }
  .ed-meta { font: 400 17px/1.4 var(--sans); color: var(--ink-2); margin: 0 0 22px; }
  .ed-intro { font-size: 1.02em; line-height: 1.6; margin: 0; padding-left: 16px; border-left: 4px solid var(--sun); }
  @media (min-width: 720px) { .ed-intro { font-size: 1.1em; padding-left: 20px; } }

  .toc { margin: 36px 0 8px; padding: 20px 22px 8px; background: var(--paper-2); border-radius: 10px; }
  .toc-title { font: 600 15px/1.3 var(--sans); letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-2); margin: 0 0 8px; }
  .toc ol { margin: 0; padding-left: 1.4em; }
  .toc li { margin: 0 0 12px; padding-left: 4px; line-height: 1.4; }
  .toc li::marker { color: var(--accent); font-weight: 650; }
  .toc a { color: var(--ink); text-decoration-color: var(--rule); }
  .toc a:hover { text-decoration-color: var(--accent); }

  .item { padding: 36px 0 34px; border-bottom: 1px solid var(--rule); scroll-margin-top: 16px; }
  .item:last-of-type { border-bottom: 0; }
  .item-title { font-size: clamp(26px, 6vw, 31px); margin: 8px 0 14px; }
  .item-summary { margin: 0 0 16px; }
  .item-caveat { margin: 0 0 16px; color: var(--ink-2); font-style: italic; }
  .item-caveat strong { font-style: normal; color: var(--ink); }
  .item-why { margin: 0 0 16px; padding: 14px 18px; background: var(--paper-2); border-radius: 8px; }
  .item-sources { margin: 0; font: 400 17px/1.5 var(--sans); color: var(--ink-2); display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: baseline; }
  .item-sources a { padding: 4px 0; }
  .sep { color: var(--ink-2); }
  .empty { font-style: italic; color: var(--ink-2); margin: 32px 0; }

  .ed-nav { margin-top: 28px; padding-top: 28px; border-top: 2px solid var(--ink); font-family: var(--sans); }
  .ed-nav-row { margin-bottom: 14px; display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; gap: 8px; min-height: 52px; padding: 12px 20px; border: 1.5px solid var(--rule); border-radius: 999px; color: var(--ink); text-decoration: none; font-size: 18px; font-weight: 500; }
  .btn:hover { border-color: var(--accent); color: var(--accent); }
  .all { display: inline-block; margin-top: 4px; font-size: 18px; padding: 6px 0; }
</style>
